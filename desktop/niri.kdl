// Personal OS. The keyboard layout is inherited from the host configuration.
input {
    keyboard {
        xkb {}
    }
    touchpad { tap; natural-scroll; dwt; }
}
layout {
    gaps 10
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.5
        proportion 0.66
        proportion 1.0
    }
    default-column-width { proportion 1.0; }
    focus-ring {
        width 2
        active-color "#94b9a8"
        inactive-color "#343c40"
    }
    border { off; }
    background-color "#181d20"
}
prefer-no-csd
animations { slowdown 0.7; }
hotkey-overlay { skip-at-startup; }
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
binds {
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+Space hotkey-overlay-title="Aplicaciones" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+P hotkey-overlay-title="Pi" { spawn "ghostty" "-e" "desk" "pi"; }
    Mod+E hotkey-overlay-title="Archivos" { spawn "nautilus"; }
    Mod+B hotkey-overlay-title="Brave" { spawn "brave"; }
    Mod+Comma hotkey-overlay-title="Ajustes" { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+L hotkey-overlay-title="Bloquear" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+V { toggle-window-floating; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Print { screenshot; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}

// DMS writes editable shortcuts here. Last include lets personal shortcuts override defaults.
include optional=true "dms/binds.kdl"
